<Window x:Class="XiaoQiaoClickTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小乔点击工具"
        Width="1298"
        Height="910"
        MinWidth="1180"
        MinHeight="820"
        WindowStartupLocation="CenterScreen"
        Background="#F8FCFF"
        FontFamily="Microsoft YaHei UI"
        FontSize="14">
    <Window.Resources>
        <LinearGradientBrush x:Key="PageBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F9FEFF" Offset="0" />
            <GradientStop Color="#DDF9FF" Offset="0.38" />
            <GradientStop Color="#F9E7F6" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#37BEFF" Offset="0" />
            <GradientStop Color="#3257FF" Offset="0.58" />
            <GradientStop Color="#7136EC" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PickingBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#42D7FF" Offset="0" />
            <GradientStop Color="#FFB43D" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PickedBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#37D985" Offset="0" />
            <GradientStop Color="#1EAF67" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PickCancelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFD7E2" Offset="0" />
            <GradientStop Color="#F48BAB" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="MiniBlueBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#42C5FF" Offset="0" />
            <GradientStop Color="#346CFF" Offset="1" />
        </LinearGradientBrush>
        <DropShadowEffect x:Key="SoftShadow" Color="#98B9FF" BlurRadius="28" ShadowDepth="8" Opacity="0.25" />
        <DropShadowEffect x:Key="BlueGlow" Color="#247CFF" BlurRadius="20" ShadowDepth="2" Opacity="0.45" />
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#DFFFFFFF" />
            <Setter Property="BorderBrush" Value="#A9C6FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="25,24" />
            <Setter Property="Effect" Value="{StaticResource SoftShadow}" />
        </Style>
        <Style x:Key="PillInput" TargetType="TextBox">
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="#001F4C" />
            <Setter Property="BorderBrush" Value="#B8CBFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#F9FDFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="24">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#001F4C" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="20" Height="20" Margin="0,0,12,0">
                                <Ellipse Stroke="#A9C6FF" StrokeThickness="1.4" Fill="#F9FDFF" />
                                <Ellipse x:Name="Dot" Margin="3" Fill="{StaticResource MiniBlueBrush}" Visibility="Collapsed" Effect="{StaticResource BlueGlow}" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GradientButton" TargetType="Button">
            <Setter Property="Height" Value="56" />
            <Setter Property="MinWidth" Value="188" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome" CornerRadius="28" Background="{StaticResource PrimaryBrush}" Effect="{StaticResource BlueGlow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.78" />
                                <Setter TargetName="ButtonChrome" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Height" Value="56" />
            <Setter Property="MinWidth" Value="154" />
            <Setter Property="Foreground" Value="#9BA9DC" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome" CornerRadius="28" Background="#EAF0FF" BorderBrush="#CFD9FF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#DCE7FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.58" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="Foreground" Value="#EF78A6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome" CornerRadius="28" Background="#FFF5FA" BorderBrush="#FFB6CF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#FF6F9E" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#F3F6FF" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#D8E2FF" />
                                <Setter Property="Foreground" Value="#9BA9DC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="20,10" CornerRadius="28" BorderBrush="#BBD0FF" BorderThickness="1" Background="{StaticResource PageBrush}" ClipToBounds="True">
        <Grid Margin="45,30,45,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="82" />
                <RowDefinition Height="*" />
                <RowDefinition Height="76" />
                <RowDefinition Height="76" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="70" Height="70" CornerRadius="20" Background="#F4FAFF" BorderBrush="#B7CBFF" BorderThickness="1" Effect="{StaticResource SoftShadow}">
                    <Image Source="pack://application:,,,/logo.png" Width="48" Height="48" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="小乔点击工具" FontSize="34" FontWeight="Black" Foreground="#002A61" />
                </StackPanel>
                <Button Grid.Column="2" Width="50" Height="50" Click="Settings_Click" Cursor="Hand" ToolTip="高级设置">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="25" Background="#EFF6FF" BorderBrush="#B7CBFF" BorderThickness="1">
                                <TextBlock Text="⚙" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" Foreground="#2469FF" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,4,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,18,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource MiniBlueBrush}" Effect="{StaticResource BlueGlow}">
                                <TextBlock Text="1" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="点击目标" Margin="12,0,0,0" FontSize="20" FontWeight="Black" Foreground="#002A61" VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Grid.Row="1" x:Name="PickPointButton" Width="116" Height="116" Margin="0,18,0,8" Click="PickPoint_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse x:Name="PickPointCircle" Fill="{StaticResource PrimaryBrush}" Effect="{StaticResource BlueGlow}" />
                                        <TextBlock Text="⊙" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-28,0,0" />
                                        <TextBlock x:Name="PickPointButtonText" Text="选择点" Foreground="White" FontSize="20" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,18,0,0" />
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="点击后 3 秒读取鼠标位置" HorizontalAlignment="Center" Foreground="#466083" FontSize="13" />
                            <Border Margin="0,8,0,0" Padding="13,5" CornerRadius="14" Background="#EEF7FF" BorderBrush="#C0D4FF" BorderThickness="1">
                                <TextBlock x:Name="CenterPointText" Text="当前坐标：X 900 / Y 500" Foreground="#2D5688" FontSize="13" FontWeight="Bold" />
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="3" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="18" Height="18" Fill="{StaticResource MiniBlueBrush}" Effect="{StaticResource BlueGlow}" />
                                <TextBlock Text="周围随机点" Margin="12,0,0,0" FontSize="18" FontWeight="Black" Foreground="#002A61" />
                            </StackPanel>
                            <CheckBox x:Name="RandomPointToggle" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True" Checked="RandomPointToggle_Changed" Unchecked="RandomPointToggle_Changed">
                                <CheckBox.Template>
                                    <ControlTemplate TargetType="CheckBox">
                                        <Border x:Name="Track" Width="52" Height="27" CornerRadius="14" Background="#3AAEFF">
                                            <Ellipse x:Name="Thumb" Width="23" Height="23" Fill="White" HorizontalAlignment="Right" Margin="2" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="Track" Property="Background" Value="#D7E2F6" />
                                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Left" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </CheckBox.Template>
                            </CheckBox>
                        </Grid>

                        <StackPanel Grid.Row="4" x:Name="RangePanel">
                            <Border x:Name="CircleRangeRow" CornerRadius="15" BorderBrush="#5A7BFF" BorderThickness="1.3" Background="#F7FBFF" Padding="12,10" MouseLeftButtonDown="CircleRangeRow_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="54" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="14" BorderBrush="#A9C6FF" BorderThickness="1" Background="#F7FCFF" ToolTip="圆形范围实时反馈监控">
                                        <Canvas x:Name="CircleMonitorCanvas" ClipToBounds="True">
                                            <Ellipse x:Name="CircleMonitorOuter" Width="34" Height="34" Canvas.Left="7" Canvas.Top="7" Stroke="#77A6FF" StrokeThickness="2" StrokeDashArray="3 3" Fill="#143A9CFF" />
                                            <Ellipse x:Name="CircleMonitorSample" Width="8" Height="8" Canvas.Left="27" Canvas.Top="16" Fill="#36BFFF" Effect="{StaticResource BlueGlow}" />
                                            <Ellipse Width="9" Height="9" Canvas.Left="19.5" Canvas.Top="19.5" Fill="#2C84FF" />
                                        </Canvas>
                                    </Border>
                                    <RadioButton Grid.Column="1" x:Name="CircleModeRadio" GroupName="RangeMode" Style="{StaticResource RoundRadio}" IsChecked="True" VerticalAlignment="Center" Checked="RangeMode_Changed" />
                                    <TextBlock Grid.Column="2" Text="圆形范围" VerticalAlignment="Center" FontSize="17" FontWeight="Bold" Foreground="#002A61" />
                                    <Slider Grid.Column="3" x:Name="CircleRangeSlider" Minimum="10" Maximum="160" Value="17" VerticalAlignment="Center" ValueChanged="RangeSlider_ValueChanged" />
                                    <TextBox Grid.Column="4" x:Name="CircleRangeValue" Text="17" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0" FontWeight="Bold" Foreground="#34527A" BorderBrush="#B8CBFF" Background="#F9FDFF" Height="32" TextChanged="RangeValue_TextChanged" PreviewKeyDown="RangeValue_PreviewKeyDown" />
                                </Grid>
                            </Border>

                            <Border x:Name="RectangleRangeRow" CornerRadius="15" BorderBrush="#C1D2FF" BorderThickness="1" Background="#FAFDFF" Padding="12,10" Margin="0,10,0,0" MouseLeftButtonDown="RectangleRangeRow_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="54" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="14" BorderBrush="#A9C6FF" BorderThickness="1" Background="#F7FCFF" ToolTip="矩形范围实时反馈监控">
                                        <Canvas x:Name="RectangleMonitorCanvas" ClipToBounds="True">
                                            <Rectangle x:Name="RectangleMonitorOuter" Width="30" Height="30" Canvas.Left="9" Canvas.Top="9" Stroke="#77A6FF" StrokeThickness="2" StrokeDashArray="3 3" Fill="#143A9CFF" RadiusX="7" RadiusY="7" />
                                            <Ellipse x:Name="RectangleMonitorSample" Width="8" Height="8" Canvas.Left="29" Canvas.Top="14" Fill="#36BFFF" Effect="{StaticResource BlueGlow}" />
                                            <Ellipse Width="9" Height="9" Canvas.Left="19.5" Canvas.Top="19.5" Fill="#2C84FF" />
                                        </Canvas>
                                    </Border>
                                    <RadioButton Grid.Column="1" x:Name="RectangleModeRadio" GroupName="RangeMode" Style="{StaticResource RoundRadio}" VerticalAlignment="Center" Checked="RangeMode_Changed" />
                                    <TextBlock Grid.Column="2" Text="矩形范围" VerticalAlignment="Center" FontSize="17" FontWeight="Bold" Foreground="#002A61" />
                                    <Slider Grid.Column="3" x:Name="RectangleRangeSlider" Minimum="10" Maximum="160" Value="17" VerticalAlignment="Center" ValueChanged="RangeSlider_ValueChanged" />
                                    <TextBox Grid.Column="4" x:Name="RectangleRangeValue" Text="17" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0" FontWeight="Bold" Foreground="#34527A" BorderBrush="#B8CBFF" Background="#F9FDFF" Height="32" TextChanged="RangeValue_TextChanged" PreviewKeyDown="RangeValue_PreviewKeyDown" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="RangeDescription" Text="随机范围：半径 17 px，围绕中心点随机落点" Margin="0,14,0,0" Foreground="#466083" FontSize="14" />
                            <TextBlock x:Name="FeedbackPointText" Text="反馈监控：中心点 900, 500，下一次会在圆形范围内随机" Margin="0,7,0,0" Foreground="#6A7FA5" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,18,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource MiniBlueBrush}" Effect="{StaticResource BlueGlow}">
                                <TextBlock Text="2" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="点击规则" Margin="12,0,0,0" FontSize="20" FontWeight="Black" Foreground="#002A61" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,34,0,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="FixedIntervalRadio" GroupName="IntervalMode" Content="固定时间" Style="{StaticResource RoundRadio}" IsChecked="True" VerticalAlignment="Center" Checked="IntervalMode_Changed" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="FixedSecondsBox" Style="{StaticResource PillInput}" Text="5" TextChanged="Settings_TextChanged" />
                                <TextBlock Text="秒" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="18" FontWeight="Bold" Foreground="#001F4C" IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="RandomIntervalRadio" GroupName="IntervalMode" Content="随机时间" Style="{StaticResource RoundRadio}" VerticalAlignment="Top" Margin="0,12,0,0" Checked="IntervalMode_Changed" />
                            <TextBox Grid.Column="1" x:Name="RandomSecondsBox" Style="{StaticResource PillInput}" Text="5,6,7,8,9,10" Height="82" TextWrapping="Wrap" AcceptsReturn="False" TextChanged="Settings_TextChanged" />
                        </Grid>
                        <TextBlock Grid.Row="3" Text="开启后每次点击前随机抽取一个间隔，最多 10 个时间点。" TextWrapping="Wrap" Foreground="#466083" Margin="0,34,0,0" FontSize="14" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource MiniBlueBrush}" Effect="{StaticResource BlueGlow}">
                                <TextBlock Text="3" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="停止方式" Margin="12,0,0,0" FontSize="20" FontWeight="Black" Foreground="#002A61" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,34,0,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="155" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="TimeStopRadio" GroupName="StopMode" Content="时间限制" Style="{StaticResource RoundRadio}" IsChecked="True" VerticalAlignment="Center" Checked="StopMode_Changed" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="LimitMinutesBox" Style="{StaticResource PillInput}" Text="10" TextChanged="Settings_TextChanged" />
                                <TextBlock Text="分钟" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="18" FontWeight="Bold" Foreground="#001F4C" IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,0,0,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="155" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="CountStopRadio" GroupName="StopMode" Content="次数限制" Style="{StaticResource RoundRadio}" VerticalAlignment="Center" Checked="StopMode_Changed" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="LimitCountBox" Style="{StaticResource PillInput}" Text="100" TextChanged="Settings_TextChanged" />
                                <TextBlock Text="次" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="18" FontWeight="Bold" Foreground="#001F4C" IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                        <RadioButton Grid.Row="3" x:Name="ManualStopRadio" GroupName="StopMode" Content="手动停止" Style="{StaticResource RoundRadio}" Checked="StopMode_Changed" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" CornerRadius="22" Background="#DFFFFFFF" BorderBrush="#B7CBFF" BorderThickness="1" Padding="25,14" Effect="{StaticResource SoftShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock x:Name="ProgressText" Text="时间进度：已运行 00:00 / 总时长 10:00 已点击 0 次" FontSize="18" FontWeight="Black" Foreground="#002A61" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#FDBA2D" Margin="0,0,8,0" />
                            <Border x:Name="StatusPill" Background="#FFB333" CornerRadius="14" Padding="14,4">
                                <TextBlock x:Name="StatusText" Text="待机" Foreground="White" FontSize="13" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <ProgressBar Grid.Row="1" x:Name="TimeProgressBar" Minimum="0" Maximum="100" Value="0" Height="18" Margin="0,10,0,0" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="StartButton" Style="{StaticResource GradientButton}" Click="Start_Click" Content="▶  开始" />
                <Button x:Name="PauseButton" Style="{StaticResource SoftButton}" Click="Pause_Click" Content="Ⅱ  暂停" Margin="24,0" />
                <Button x:Name="StopButton" Style="{StaticResource DangerButton}" Click="Stop_Click" Content="▪  停止" />
            </StackPanel>

            <Border Grid.Row="4" BorderBrush="#B7CBFF" BorderThickness="0,1,0,0">
                <TextBlock Text="◆    版权所有：小乔老师    联系方式：14758886948" HorizontalAlignment="Center" VerticalAlignment="Bottom" Foreground="#58739D" FontWeight="Bold" />
            </Border>
        </Grid>
    </Border>
</Window>
